{
  "name": "homebridge-ecoflow-river-3-plus",
  "displayName": "EcoFlow RIVER 3 Plus",
  "version": "0.7.0",
  "description": "Homebridge plugin that adds the EcoFlow RIVER 3 Plus power station to Apple Home",
  "license": "Apache-2.0",
  "main": "dist/index.js",
  "files": [
    "dist",
    "proto",
    "config.schema.json",
    "NOTICE",
    "LICENSE"
  ],
  "keywords": [
    "homebridge-plugin",
    "ecoflow",
    "river 3",
    "river 3 plus",
    "homekit",
    "matter"
  ],
  "engines": {
    "node": "^20.18.0 || ^22.12.0 || ^24 || ^26",
    "homebridge": "^1.8.0 || ^2.0.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json",
    "test": "rm -rf .test-build && tsc -p tsconfig.test.json && node --test .test-build/test",
    "prepublishOnly": "npm run build && npm test",
    "prepare": "npm run build",
    "probe": "node scripts/probe.mjs"
  },
  "dependencies": {
    "mqtt": "^5.16.1",
    "protobufjs": "^8.8.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "homebridge": "^2.5.0",
    "typescript": "^5.9.3"
  },
  "type": "module",
  "exports": "./dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ridzria/homebridge-ecoflow-river-3-plus.git"
  },
  "bugs": {
    "url": "https://github.com/ridzria/homebridge-ecoflow-river-3-plus/issues"
  },
  "homepage": "https://github.com/ridzria/homebridge-ecoflow-river-3-plus#readme"
}
